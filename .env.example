# --- TikTok Shop Partner app (Partner Center > App & Service) ---
TTS_APP_KEY=6ivptjmfbl9na
TTS_APP_SECRET=xxxxxxxxxxxxxxxxxxxx
# Chi dung cho luong PARTNER (MCN/CAP/TAP). Link uy quyen CREATOR dung app_key, khong dung service_id.
TTS_SERVICE_ID=7602529679438432021

# Host sinh link uy quyen. Ba luong dung ba host KHAC HAN nhau, khong thay the nhau duoc:
#   partner: partner.tiktokshop.com/open/authorize?service_id=   (US: partner.us.)
#   creator: shop.tiktok.com/alliance/creator/auth?app_key=      (state BAT BUOC)
TTS_PARTNER_AUTH_HOST=https://partner.tiktokshop.com
TTS_CREATOR_AUTH_HOST=https://shop.tiktok.com

# Phai trung TUYET DOI voi o "Redirect URL" trong Partner Center (https, khong dau / cuoi)
TTS_REDIRECT_URL=https://metrics.upbase.asia/api/tiktok/callback

# Host API. Non-US: open-api.tiktokglobalshop.com
TTS_API_HOST=https://open-api.tiktokglobalshop.com
TTS_AUTH_HOST=https://auth.tiktok-shops.com

# --- Dang nhap dashboard (basic auth). Thieu bien nay server tu choi khoi dong. ---
DASHBOARD_USER=upbase
DASHBOARD_PASSWORD=doi-thanh-chuoi-ngau-nhien-dai

# Ghi de cipher cua category asset 'Creator Management' (doc TikTok canh bao ten category
# "may change", doi ten la capCipher() khong tim ra nua).
# TTS_CAP_CIPHER=

# BAT BUOC neu muon lay target_collaborations. Endpoint do doi shop_id, ma KHONG API nao
# ta goi duoc tra ve shop_id: cap_order chi co shop_name, showcase chi co shop.name, va
# API duy nhat tra ve shop id (/authorization/202309/shops) doi scope seller.authorization.info
# tuc TUNG SELLER phai uy quyen app -- khong kha thi voi MCN. => phai lay tay tu Partner
# Center / URL shop roi dan vao day, cach nhau bang dau phay.
# Thieu bien nay: sync creator van chay, rieng metric target_collaborations RONG (khac 0).
TTS_SHOP_IDS=

DATABASE_URL=postgres://tiktok:tiktok@localhost:5432/tiktok_metrics
PORT=3000
# Trang ve sau khi creator uy quyen xong
APP_BASE_URL=https://metrics.upbase.asia
